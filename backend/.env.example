NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Outside managed Google infrastructure, set the absolute path to your private service account file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-this-repository/service-account.json
# Optional. The rest of the API works without this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_HOUR=20
AI_GLOBAL_REQUESTS_PER_HOUR=200
USE_FIREBASE_EMULATORS=false
# Uncomment all three ONLY for explicit local emulator mode:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
