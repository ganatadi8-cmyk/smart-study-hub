NODE_ENV=development
PORT=5000
PUBLIC_API_URL=http://localhost:5000/api
CORS_ORIGINS=http://localhost:5173

# Backend ONLY. Copy both URLs from your smart-study-hub Neon database's Connect dialog.
# Do not put credentials in VITE_* variables or commit .env files.
DATABASE_URL=postgresql://ROLE:PASSWORD@NEON_POOLED_HOST/DATABASE?sslmode=require
# Use the direct hostname without -pooler for migrations on a trusted machine.
DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@NEON_DIRECT_HOST/DATABASE?sslmode=require

# Firebase is used for sign-in/role claims and optional files, NOT the app database.
FIREBASE_PROJECT_ID=studyhub-16fdf-53e36
# Optional until Storage is provisioned. HTTPS video links work without it.
# FIREBASE_STORAGE_BUCKET=your-actual-bucket-name
# Local credentials must live outside the repository:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside-this-repository/service-account.json
# On Vercel, add the complete JSON as a sensitive backend-only environment variable:
# FIREBASE_SERVICE_ACCOUNT_JSON=<complete service-account JSON>

# Optional; the API still works when AI is disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_REQUESTS_PER_HOUR=20
AI_GLOBAL_REQUESTS_PER_HOUR=200
USE_FIREBASE_EMULATORS=false
# Local Auth/Storage emulators only (database remains local PostgreSQL or a Neon dev branch):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
